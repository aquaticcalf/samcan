{
  "name": "samcan",
  "version": "0.1.0",
  "description": "canvas",
  "license": "MIT",
  "author": "aquaticcalf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aquaticcalf/samcan.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/editor/index.d.ts",
        "default": "./dist/editor/index.js"
      },
      "require": {
        "types": "./dist/editor/index.d.cts",
        "default": "./dist/editor/index.cjs"
      }
    },
    "./camera": {
      "import": {
        "types": "./dist/camera/index.d.ts",
        "default": "./dist/camera/index.js"
      },
      "require": {
        "types": "./dist/camera/index.d.cts",
        "default": "./dist/camera/index.cjs"
      }
    },
    "./document": {
      "import": {
        "types": "./dist/document/index.d.ts",
        "default": "./dist/document/index.js"
      },
      "require": {
        "types": "./dist/document/index.d.cts",
        "default": "./dist/document/index.cjs"
      }
    },
    "./math": {
      "import": {
        "types": "./dist/math/index.d.ts",
        "default": "./dist/math/index.js"
      },
      "require": {
        "types": "./dist/math/index.d.cts",
        "default": "./dist/math/index.cjs"
      }
    },
    "./renderer": {
      "import": {
        "types": "./dist/renderer/index.d.ts",
        "default": "./dist/renderer/index.js"
      },
      "require": {
        "types": "./dist/renderer/index.d.cts",
        "default": "./dist/renderer/index.cjs"
      }
    },
    "./spatial": {
      "import": {
        "types": "./dist/spatial/index.d.ts",
        "default": "./dist/spatial/index.js"
      },
      "require": {
        "types": "./dist/spatial/index.d.cts",
        "default": "./dist/spatial/index.cjs"
      }
    },
    "./stroke": {
      "import": {
        "types": "./dist/stroke/index.d.ts",
        "default": "./dist/stroke/index.js"
      },
      "require": {
        "types": "./dist/stroke/index.d.cts",
        "default": "./dist/stroke/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine/index.js"
      },
      "require": {
        "types": "./dist/engine/index.d.cts",
        "default": "./dist/engine/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "fix": "oxfmt -c config/oxfmt.json && oxlint -c config/oxlint.json --fix && tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "bunup": "^0.16.31",
    "husky": "^9.1.7",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.42.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
